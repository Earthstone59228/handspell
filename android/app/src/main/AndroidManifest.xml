<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Live hand-landmark detection from the front camera; never leaves the device. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Only used by the RevenueCat SDK to validate the "pro" entitlement (docs/ARCHITECTURE.md §10). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Both declared android:required="false": lint (PermissionImpliesUnsupportedChromeOsHardware)
         wants the general camera feature disclaimed too, since CAMERA implies it by default. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.front"
        android:required="false" />

    <application
        android:name=".HandspellApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
